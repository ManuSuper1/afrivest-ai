# --- Model provider (pick one, set the matching key) -----------------------
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
# OPENAI_API_KEY="your-openai-api-key-here"
# GOOGLE_API_KEY="your-google-api-key-here"

AFRIVEST_ORCHESTRATOR_MODEL=anthropic:claude-sonnet-4-6
AFRIVEST_SUBAGENT_MODEL=anthropic:claude-sonnet-4-6

# --- Run length --------------------------------------------------------
# Max tokens for a single LLM completion (orchestrator vs. subagents).
AFRIVEST_ORCHESTRATOR_MAX_TOKENS=8192
AFRIVEST_SUBAGENT_MAX_TOKENS=6144
# Max LangGraph steps (tool calls + LLM turns) in one research run.
# A 4-subagent run with a few search rounds each can easily need 150-300.
AFRIVEST_RECURSION_LIMIT=300

# --- Search --------------------------------------------------------------
TAVILY_API_KEY="your-tavily-api-key-here"

# --- Persistence -----------------------------------------------------------
# "memory" (default, single-process/dev only) or "postgres"
AFRIVEST_PERSISTENCE=memory
# AFRIVEST_POSTGRES_URI=postgresql://user:pass@host:5432/afrivest

# --- Misc ------------------------------------------------------------------
AFRIVEST_ENABLE_TASK_PLANNING=true
# Enables detailed AfriVest DEBUG logs in the API terminal when true.
AFRIVEST_DEBUG=false
